#!/bin/bash

set -euo pipefail

readonly CYAN='\033[0;36m'
readonly BOLD_GREEN='\033[1;32m'
readonly RESET='\033[0m'
readonly PREFIX="${CYAN}[.githooks/pre-push]${RESET}"

function checkInstalled() {
	local cmd="$1"
	if ! command -v "$cmd" &>/dev/null; then
		echo "Error: $cmd is not installed. Please install it to proceed." >&2
		exit 1
	fi
}

function checkTidy() {
	echo -e "${PREFIX} Checking go.mod and go.sum..."
	if ! go mod tidy -diff >/dev/null 2>&1; then
		echo "Error: go.mod or go.sum is not tidy. Please run 'go mod tidy' to fix it." >&2
		exit 1
	fi
}

function runLinters() {
	echo -e "${PREFIX} Running linters..."
	golangci-lint run
}

function main() {
	echo -e "${PREFIX} Starting pre-push checks..."
	checkInstalled "go"
	checkInstalled "golangci-lint"
	checkTidy
	runLinters
	echo -e "${PREFIX} ${BOLD_GREEN}DONE!${RESET}"
}

main "$@"
